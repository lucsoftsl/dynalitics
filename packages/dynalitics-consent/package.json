{
  "name": "dynalitics-consent",
  "version": "0.2.0",
  "description": "Optional consent banner for dynalitics (plain DOM and React) plus a server helper that turns the visitor's choice into the boolean track() takes.",
  "keywords": [
    "analytics",
    "dynalitics",
    "consent",
    "cookie-banner",
    "gdpr",
    "privacy",
    "react"
  ],
  "license": "MIT",
  "author": "dynalitics contributors",
  "homepage": "https://github.com/lucsoftsl/dynalitics/tree/main/packages/dynalitics-consent#readme",
  "bugs": {
    "url": "https://github.com/lucsoftsl/dynalitics/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lucsoftsl/dynalitics.git",
    "directory": "packages/dynalitics-consent"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "sideEffects": [
    "*.css"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "default": "./dist/react/index.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "default": "./dist/server.js"
    },
    "./styles.css": "./dist/styles.css"
  },
  "files": [
    "dist",
    "!dist/**/*.map",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -b && node scripts/copy-css.mjs"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
